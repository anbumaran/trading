// © fluxchart
//@version=6
indicator("ORB & PDHL", overlay=true, max_lines_count=500, max_bars_back=5000)

// --- INPUTS ---
orbTimeStr          = input.timeframe("60", "ORB Timeframe", group="Algorithm")
customSessionEnabled= input.bool(false, "Enabled", group="Custom Session")
customSessionTime = input.session("0915-1015", "Start Time", group="Custom Session", tooltip="Select Start time only. End time will be calculated based on the ORB timeframe.")

showORBZones        = input.bool(true, "Show ORB", group="ORB Visuals")
showHistoricZones   = input.bool(false, "Show Historic ORB", group="ORB Visuals")
orbHighColor        = input.color(color.green, "High Color", group="ORB Visuals")
orbLowColor         = input.color(color.red, "Low Color", group="ORB Visuals")
orbLineType         = input.string("Dotted", "Line Type", options=["Solid", "Dashed", "Dotted"], group="ORB Visuals")
orbLineWidth        = input.int(2, "Line Width", minval=1, maxval=5, group="ORB Visuals")

showPDH_PDL         = input.bool(true, "Show PDH & PDL", group="PDHL Visuals")
showHistoricPDHL    = input.bool(false, "Show Historic PDH & PDL", group="PDHL Visuals")
pdhColor            = input.color(color.green, "PDH Color", group="PDHL Visuals")
pdlColor            = input.color(color.red, "PDL Color", group="PDHL Visuals")
pdhlLineType        = input.string("Solid", "Line Type", options=["Solid", "Dashed", "Dotted"], group="PDHL Visuals")
pdhlLineWidth       = input.int(1, "Line Width", minval=1, maxval=5, group="PDHL Visuals")

// --- HELPERS ---
getStyle(string t) => t == "Dashed" ? line.style_dashed : t == "Dotted" ? line.style_dotted : line.style_solid

orbStyle  = getStyle(orbLineType)
pdhlStyle = getStyle(pdhlLineType)

// --- TYPES & ARRAYS ---
type ORB
    float h
    float l
    int startIndex
    int endIndex
    int startTime
    bool isFormed
    line hLine
    line lLine

type PDHL
    float h
    float l
    int startIndex
    int endIndex
    line hLine
    line lLine

var orbList  = array.new<ORB>()
var pdhlList = array.new<PDHL>()

// --- SESSION LOGIC ---
sessionBegins(sess) =>
    t = time("1440", sess)
    (na(t[1]) and not na(t)) or t[1] < t

isNewSession = customSessionEnabled ? sessionBegins(customSessionTime) : session.isfirstbar_regular

// --- ORB TRACKING ---
if barstate.isconfirmed and last_bar_index - bar_index < 5000
    if isNewSession
        if orbList.size() > 0
            ORB prevORB = orbList.get(0)
            prevORB.endIndex := bar_index - 1
        orbList.unshift(ORB.new(na, na, bar_index, na, time, false, na, na))

    if orbList.size() > 0
        ORB lastORB = orbList.get(0)
        if not lastORB.isFormed
            if time < lastORB.startTime + timeframe.in_seconds(orbTimeStr) * 1000
                lastORB.h := math.max(nz(lastORB.h, high), high)
                lastORB.l := math.min(nz(lastORB.l, low), low)
            else
                lastORB.isFormed := true

// --- PDHL TRACKING ---
prevHigh = request.security(syminfo.tickerid, "D", high[1], lookahead=barmerge.lookahead_on)
prevLow  = request.security(syminfo.tickerid, "D", low[1], lookahead=barmerge.lookahead_on)

isNewDay = timeframe.isintraday and (na(time("D")[1]) or time("D") != time("D")[1])

if isNewDay
    pdhlList.unshift(PDHL.new(prevHigh, prevLow, bar_index, bar_index, na, na))

if pdhlList.size() > 0
    PDHL lastPDHL = pdhlList.get(0)
    lastPDHL.endIndex := bar_index

// --- RENDER ON LAST BAR ---
if barstate.islast
    // Render ORB Lines
    if showORBZones and orbList.size() > 0
        int count = showHistoricZones ? math.min(orbList.size(), 100) : 1
        for i = 0 to count - 1
            ORB o = orbList.get(i)
            if not na(o.hLine)
                line.delete(o.hLine)
                line.delete(o.lLine)
            endIdx = nz(o.endIndex, last_bar_index)
            o.hLine := line.new(o.startIndex, o.h, endIdx, o.h, color=orbHighColor, width=orbLineWidth, style=orbStyle)
            o.lLine := line.new(o.startIndex, o.l, endIdx, o.l, color=orbLowColor, width=orbLineWidth, style=orbStyle)

    // Render PDHL Lines
    if showPDH_PDL and timeframe.isintraday and pdhlList.size() > 0
        int count = showHistoricPDHL ? math.min(pdhlList.size(), 100) : 1
        for i = 0 to count - 1
            PDHL p = pdhlList.get(i)
            if not na(p.hLine)
                line.delete(p.hLine)
                line.delete(p.lLine)
            p.hLine := line.new(p.startIndex, p.h, p.endIndex, p.h, color=pdhColor, width=pdhlLineWidth, style=pdhlStyle)
            p.lLine := line.new(p.startIndex, p.l, p.endIndex, p.l, color=pdlColor, width=pdhlLineWidth, style=pdhlStyle)